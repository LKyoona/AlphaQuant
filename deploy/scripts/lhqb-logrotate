/data/lhqb/logs/nginx/*.log {
    su root www-data
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    create 0640 www-data adm
    sharedscripts
    postrotate
        [ ! -f /run/nginx.pid ] || kill -USR1 $(cat /run/nginx.pid)
    endscript
}

/data/lhqb/logs/php/*.log
/data/lhqb/logs/application/*.log
/data/lhqb/logs/crawler/*.log {
    su root www-data
    daily
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    dateext
    copytruncate
}
