[Unit]
Description=Neuranet production health check
After=network-online.target nginx.service php8.1-fpm.service mysql.service redis-server.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/lhqb-health-check
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/data/lhqb/logs/application
