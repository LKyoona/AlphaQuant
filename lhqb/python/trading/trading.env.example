# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lhqb
DB_USERNAME=root
DB_PASSWORD=change-me
DB_PREFIX=jl_

# Redis and market data
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
MARKET_REDIS_PREFIX=lhqb:market:v1

# Runtime
TRADING_POLL_SECONDS=10
TRADING_WORKERS=4
TRADING_LOCK_SECONDS=120
TRADING_EXCHANGE_TIMEOUT_MS=30000
TRADING_LOG_LEVEL=INFO

# Real orders require this value and the --live CLI flag at the same time.
TRADING_EXECUTION_ENABLED=false
